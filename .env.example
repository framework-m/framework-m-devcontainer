# Framework M Enterprise Setup

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/framework_m

# Cache & PubSub (Redis)
REDIS_URL=redis://redis:6379/0

# Event Bus (NATS)
NATS_URL=nats://nats:4222

# Mode Configuration
FRAMEWORK_M_TENANCY_MODE=multi
FRAMEWORK_M_JWT_SECRET=dev-secret-only-for-devcontainer
HOST=0.0.0.0
# For Vite
VITE_HOST=0.0.0.0
INSTALLED_APPS=my_app
FRAMEWORK_M_DEBUG=true
LOG_LEVEL=DEBUG
